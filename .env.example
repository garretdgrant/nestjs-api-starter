# dev | stag | prod. Swagger UI is disabled when this is "prod".
ENVIRONMENT=dev
PORT=8000

# Matches the database started by `just start-local-db`.
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/api_starter

# Signs access tokens. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Access token lifetime (for example 15m, 1h).
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30
